{
  "name": "orbit-chat",
  "version": "2.0.0-aaa",
  "private": true,
  "description": "ORBIT Desktop — a polished realtime community, chat and calls experience.",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server-v2.js",
    "dev": "node server-v2.js",
    "desktop": "electron .",
    "desktop:dist": "electron-builder --win nsis portable --publish never"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "socket.io": "^4.8.1",
    "@huggingface/transformers": "^3.8.1"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.orbit.chat",
    "productName": "ORBIT",
    "artifactName": "ORBIT-${version}-${arch}.${ext}",
    "asar": true,
    "files": [
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "dist-desktop"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "ORBIT"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ORBIT"
    }
  }
}
