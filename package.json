{
  "name": "orbit-chat",
  "version": "1.3.0",
  "private": true,
  "description": "ORBIT Desktop — a polished realtime community, chat and calls experience.",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "desktop": "electron .",
    "desktop:dist": "electron-builder --win nsis portable --publish never",
    "test": "node --test tests",
    "db:migrate": "node db/migrate.js",
    "check": "node --check server.js && node --check worker.js && node --check platform/security.js && node --check platform/config.js && node --check platform/manifest.js && node --check platform/session.js && node --check platform/realtime.js && node --check platform/storage.js && node --check platform/jobs.js && node --check platform/permissions.js && node --check platform/totp.js",
    "worker": "node worker.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "socket.io": "^4.8.1",
    "@huggingface/transformers": "^3.8.1",
    "helmet": "^8.3.0",
    "express-rate-limit": "^8.7.0",
    "redis": "^6.2.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.orbit.chat",
    "productName": "ORBIT",
    "artifactName": "ORBIT-${version}-${arch}.${ext}",
    "asar": true,
    "files": [
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "dist-desktop"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "executableName": "ORBIT"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ORBIT"
    }
  }
}
